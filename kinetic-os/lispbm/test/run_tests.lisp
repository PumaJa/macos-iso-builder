(defun mk-par (pin pm e)
  (let ((b (bufcreate 13)))
    { (bufset-u8 b 0 0x4B) (bufset-u8 b 1 2) (bufset-u8 b 2 8) (bufset-u32 b 3 pin) (bufset-u16 b 7 pm) (bufset-u32 b 9 e) b }))
