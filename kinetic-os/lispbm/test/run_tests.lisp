;;; run_tests.lisp - assert-style tests for kinetic.lisp (run after stubs.lisp
;;; and kinetic.lisp minus its autostart section). See run_tests.sh.

(define t-run 0)
(define t-fail 0)

(defun check (name ok)
  {
    (define t-run (+ t-run 1))
    (if ok
        (print "PASS " name)
        {
          (define t-fail (+ t-fail 1))
          (print "FAIL " name)
        })
  })

(defun approx (a b) (< (abs (- a b)) 0.001))

;; ---- helpers
(defun mk (l)
  (let ((b (bufcreate (length l))))
    {
      (looprange i 0 (length l) (bufset-u8 b i (ix l i)))
      b
    }))

;; cmd 2 request: slot, scale permille, watts, 0.1A, erpm
(defun mk-custom (slot sc w a e)
  (let ((b (bufcreate 14)))
    {
      (bufset-u8 b 0 0x4B) (bufset-u8 b 1 1) (bufset-u8 b 2 2) (bufset-u8 b 3 slot)
      (bufset-u16 b 4 sc) (bufset-u16 b 6 w) (bufset-u16 b 8 a) (bufset-u32 b 10 e)
      b
    }))

(defun mk-custom2 (slot sc w a e)
  (let ((b (bufcreate 16)))
    {
      (bufset-u8 b 0 0x4B) (bufset-u8 b 1 2) (bufset-u8 b 2 2) (bufset-u8 b 3 slot)
      (bufset-u16 b 4 sc) (bufset-u32 b 6 w) (bufset-u16 b 10 a) (bufset-u32 b 12 e)
      b
    }))

(define d-m-scale m-scale)
(define d-m-watt  m-watt)
(define d-m-icur  m-icur)
(define d-m-erpm  m-erpm)

(defun reset ()
  {
    (define stub-conf
      (list (cons 'l-current-max-scale ceil-scale) (cons 'l-watt-max ceil-watt)
            (cons 'l-in-current-max ceil-icur) (cons 'l-max-erpm ceil-erpm)
            (cons 'l-battery-cut-start bat-cut)))
    (define stub-fet 25.0) (define stub-mot 25.0) (define stub-vin 50.0) (define stub-rpm 0.0)
    (define m-scale d-m-scale) (define m-watt d-m-watt)
    (define m-icur d-m-icur) (define m-erpm d-m-erpm)
    (define cur-mode 0) (define last-reject 0) (define flags 0) (define req-ver 2)
    (define locked 0) (define pin-x nil) (define fail-cnt 0) (define fail-series 0)
    (define lock-until 0.0) (define uptime 0.0) (define tamper 0) (define tamper-t 0.0)
    (define lock-reassert 0) (define ep-cnt 0) (define ep-series 0)
    (define neutral 0) (define par-scale 1.0) (define par-erpm 0.0) (define par-dirty 0) (define ep-par-pm 1000) (define ep-par-e 0)
    (define stub-eeprom nil) (define stub-eeprom-writes 0) (define stub-out-disabled nil) (define stub-out-log nil)
    (define eff-scale (mode-scale 0)) (define applied-scale -1.0)
    (define t-fet 25.0) (define t-mot 25.0) (define vin 50.0) (define erpm 0.0)
    (define use-mot-temp 1)
    (define tc-pct 0) (define tc-scale 1.0) (define tc-prev-erpm 0.0) (define tc-air-t 0.0) (define tc-air 0)
    (define stub-cur 0.0) (define stub-imu nil)
    (apply-static)
    (define stub-conf-log nil)
    (define stub-sent nil)
  })

(defun nsent () (length stub-sent))
(defun rb (i) (bufget-u8 (ix stub-sent 0) i))
(defun send-req (l) (proc-data (mk l)))
(defun ticks (n) (looprange i 0 n (derate-tick)))
(defun cget (k) (assoc stub-conf k))

;; count conf-set log entries exceeding the boot ceiling
(defun violations ()
  (let ((n 0))
    {
      (looprange i 0 (length stub-conf-log)
        (let ((e (ix stub-conf-log i)))
          (let ((k (car e)) (v (cdr e)))
            (if (or (and (eq k 'l-current-max-scale) (> v (+ ceil-scale 0.0001)))
                    (and (eq k 'l-watt-max)          (> v (+ ceil-watt 0.0001)))
                    (and (eq k 'l-in-current-max)    (> v (+ ceil-icur 0.0001)))
                    (and (eq k 'l-max-erpm)          (> v (+ ceil-erpm 0.0001))))
                (setq n (+ n 1))
                nil))))
      n
    }))

;; =========================================================== 1. boot ceiling
(reset)
(check "boot: ceil-scale read"  (approx ceil-scale 1.0))
(check "boot: ceil-watt read"   (approx ceil-watt 1500.0))
(check "boot: ceil-icur read"   (approx ceil-icur 30.0))
(check "boot: ceil-erpm read"   (approx ceil-erpm 100000.0))
(check "boot: v-start auto = cut-start + margin" (approx v-start 45.0))
(check "boot: v-end auto = cut-start"            (approx v-end 42.0))
(check "boot: starts in eco (mode 0)" (= cur-mode 0))
(check "boot: eco watt applied (40%)" (approx (cget 'l-watt-max) 600.0))
(check "boot: eco icur applied (40%)" (approx (cget 'l-in-current-max) 12.0))
(check "boot: eco erpm applied (50%)" (approx (cget 'l-max-erpm) 50000.0))
(check "boot: initial eff-scale = eco scale" (approx eff-scale 0.4))

;; ============================================== 2. mode change, stationary
(reset)
(send-req (list 0x4B 1 1 2))
(check "stationary: race accepted" (= cur-mode 2))
(check "v1 request: reply version byte echoes 1" (= (rb 1) 1))
(check "stationary: reply result 0" (= (rb 3) 0))
(check "stationary: reply echoes cmd 1" (= (rb 2) 1))
(check "stationary: reply mode byte" (= (rb 4) 2))
(check "stationary: race watt = ceiling" (approx (cget 'l-watt-max) ceil-watt))
(check "stationary: race erpm = ceiling" (approx (cget 'l-max-erpm) ceil-erpm))
(send-req (list 0x4B 1 1 1))
(check "stationary: sport accepted (down)" (= cur-mode 1))
(check "stationary: sport watt 70%" (approx (cget 'l-watt-max) 1050.0))

;; ======================================== 3. more powerful rejected moving
(reset)
(define stub-rpm 5000.0)
(derate-tick)
(define n0 (nsent))
(send-req (list 0x4B 1 1 2))
(check "moving: eco->race rejected (mode unchanged)" (= cur-mode 0))
(check "moving: reply sent" (= (nsent) (+ n0 1)))
(check "moving: reply result = reject 3" (= (rb 3) 3))
(check "moving: reply last-reject byte = 3" (= (rb 8) 3))
(check "moving: last-reject var = 3" (= last-reject 3))
(check "moving: eco->sport rejected" (progn (send-req (list 0x4B 1 1 1)) (= cur-mode 0)))
(check "moving: eco->custom1 rejected (scale 0.5>0.4)" (progn (send-req (list 0x4B 1 1 3)) (= cur-mode 0)))
(check "moving: limits untouched by rejection" (approx (cget 'l-watt-max) 600.0))
(define stub-rpm -5000.0)
(derate-tick)
(send-req (list 0x4B 1 1 2))
(check "moving reverse (negative erpm): rejected" (and (= cur-mode 0) (= (rb 3) 3)))
(define stub-rpm 299.0)
(derate-tick)
(send-req (list 0x4B 1 1 2))
(check "|erpm| just under stop-erpm: accepted" (= cur-mode 2))
(reset)
(define stub-rpm 300.0)
(derate-tick)
(send-req (list 0x4B 1 1 2))
(check "|erpm| == stop-erpm counts as moving: rejected" (and (= cur-mode 0) (= (rb 3) 3)))
(send-req (list 0x4B 1 1 7))
(check "bad mode index 7: code 2" (and (= (rb 3) 2) (= cur-mode 0) (= last-reject 2)))
(send-req (list 0x4B 1 1 5))
(check "bad mode index 5: code 2" (= (rb 3) 2))
(send-req (list 0x4B 1 1 255))
(check "bad mode index 255: code 2" (= (rb 3) 2))

;; ================================================ 4. less powerful moving
(reset)
(send-req (list 0x4B 1 1 2))
(define stub-rpm 8000.0)
(derate-tick)
(send-req (list 0x4B 1 1 0))
(check "moving: race->eco accepted" (and (= cur-mode 0) (= (rb 3) 0)))
(check "moving: accepted clears last-reject" (= last-reject 0))
(check "moving: eco limits applied" (approx (cget 'l-watt-max) 600.0))
(reset)
(send-req (list 0x4B 1 1 1))
(define stub-rpm 8000.0)
(derate-tick)
(send-req (list 0x4B 1 1 3))
(check "moving: sport->custom1 accepted (all limits <=)" (= cur-mode 3))
