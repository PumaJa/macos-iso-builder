;; ====================================================== 5. custom params
(reset)
(proc-data (mk-custom 3 5000 65535 65535 4294967295))
(check "custom: reply result 0" (and (= (rb 2) 2) (= (rb 3) 0)))
(check "custom: scale clamped to 1.0" (approx (ix m-scale 3) 1.0))
(check "custom: watt clamped to ceiling" (<= (ix m-watt 3) ceil-watt))
(check "custom: icur clamped to ceiling" (<= (ix m-icur 3) ceil-icur))
(check "custom: erpm clamped to ceiling" (<= (ix m-erpm 3) ceil-erpm))
(check "custom: clamped values == ceiling" (and (approx (ix m-watt 3) ceil-watt) (approx (ix m-icur 3) ceil-icur) (approx (ix m-erpm 3) ceil-erpm)))
(check "custom: does not select slot" (= cur-mode 0))
(send-req (list 0x4B 1 1 3))
(check "custom: selecting clamped slot applies <= ceiling" (and (= cur-mode 3) (<= (cget 'l-watt-max) ceil-watt) (<= (cget 'l-in-current-max) ceil-icur) (<= (cget 'l-max-erpm) ceil-erpm)))
(check "custom: no conf-set above ceiling" (= (violations) 0))
(reset)
(proc-data (mk-custom 4 250 300 100 20000))
(check "custom: in-range scale 0.25" (approx (ix m-scale 4) 0.25))
(check "custom: in-range watt 300" (approx (ix m-watt 4) 300.0))
(check "custom: in-range icur 10.0 A" (approx (ix m-icur 4) 10.0))
(check "custom: in-range erpm 20000" (approx (ix m-erpm 4) 20000.0))
(check "custom: other slot untouched" (approx (ix m-watt 3) (* ceil-watt 0.5)))
(proc-data (mk-custom 2 100 100 100 100))
(check "custom: slot 2 rejected code 6" (and (= (rb 3) 6) (= (rb 2) 2) (approx (ix m-watt 2) ceil-watt)))
(proc-data (mk-custom 5 100 100 100 100))
(check "custom: slot 5 rejected code 6" (= (rb 3) 6))
(proc-data (mk (list 0x4B 1 2 3 0 1)))
(check "custom: short packet rejected code 4" (and (= (rb 3) 4) (= (rb 2) 2)))
;; active custom slot while moving
(reset)
(send-req (list 0x4B 1 1 3))
(define stub-rpm 5000.0)
(derate-tick)
(proc-data (mk-custom 3 900 1400 250 90000))
(check "custom active+moving: increase rejected code 3" (and (= (rb 3) 3) (approx (ix m-watt 3) 750.0)))
(proc-data (mk-custom 3 300 400 100 10000))
(check "custom active+moving: decrease accepted" (and (= (rb 3) 0) (approx (ix m-watt 3) 400.0)))
(check "custom active+moving: decrease applied immediately" (approx (cget 'l-watt-max) 400.0))
(proc-data (mk-custom 4 1000 1500 300 100000))
(check "custom inactive slot+moving: increase allowed (not active)" (and (= (rb 3) 0) (approx (ix m-watt 4) ceil-watt)))
(define stub-rpm 0.0)
(derate-tick)
(proc-data (mk-custom 3 900 1400 250 90000))
(check "custom active+stationary: increase accepted + applied" (and (= (rb 3) 0) (approx (cget 'l-watt-max) 1400.0)))


;; ================================================ 5b. protocol v2 (u32 watts)
(reset)
(define big-ceil ceil-watt)
(define ceil-watt 200000.0)          ; pretend a 200 kW-class ceiling
(define m-watt (list 80000.0 140000.0 200000.0 100000.0 100000.0))
(proc-data (mk-custom2 3 500 120000 250 50000))
(check "v2 custom: accepted, reply echoes version 2" (and (= (rb 3) 0) (= (rb 2) 2) (= (rb 1) 2)))
(check "v2 custom: 120000 W stored exactly" (approx (ix m-watt 3) 120000.0))
(check "v2 custom: other fields decoded (scale/A/erpm)" (and (approx (ix m-scale 3) 0.5) (approx (ix m-icur 3) 25.0) (approx (ix m-erpm 3) 50000.0)))
(proc-data (mk-custom2 4 1000 4000000000 65535 4294967295))
(check "v2 custom: 4e9 W clamped to ceiling 200000" (approx (ix m-watt 4) 200000.0))
(check "v2 custom: icur/erpm clamped to ceiling" (and (<= (ix m-icur 4) ceil-icur) (<= (ix m-erpm 4) ceil-erpm)))
(proc-data (mk-custom 4 1000 65535 300 50000))
(check "v1 custom (u16 layout) still works on same ceiling" (and (= (rb 3) 0) (= (rb 1) 1) (approx (ix m-watt 4) 65535.0) (approx (ix m-icur 4) 30.0) (approx (ix m-erpm 4) 50000.0)))
(proc-data (mk (list 0x4B 2 2 3 0 1 0 0 0 1 0 1 0 0 0 1)))
(check "v2 custom: 16-byte u32 field byte order (watt=1 W)" (approx (ix m-watt 3) 1.0))
(proc-data (let ((b (mk-custom 3 100 100 100 100))) {(bufset-u8 b 1 2) b}))
(check "v2 with 14-byte (v1-sized) packet: short, code 4" (and (= (rb 3) 4) (= (rb 1) 2)))
(proc-data (mk-custom2 7 1 1 1 1))
(check "v2 custom: bad slot code 6" (= (rb 3) 6))
(send-req (list 0x4B 2 3))
(check "v2 status request: reply version 2, 24 bytes" (and (= (rb 1) 2) (= (buflen (ix stub-sent 0)) 24)))
(send-req (list 0x4B 1 3))
(check "v1 status request: reply version 1" (= (rb 1) 1))
(send-req (list 0x4B 2 1 2))
(check "v2 set-mode works" (= cur-mode 2))
(define ceil-watt big-ceil)

