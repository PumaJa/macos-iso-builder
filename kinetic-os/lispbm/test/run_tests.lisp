(par-with 1 500 1000) (par-with 1 500 1000) (par-with 1 500 1000) (par-with 1 500 1000) (par-with 1 500 1000)
(par-with 1234 500 1000)
(check "parental PIN guessing triggers lockout (code 9)" (and (= (rb 3) 9) (not (par-active))))
(reset)
(proc-data (mk-setpin 0 1234))
(lock-with 1234)
(par-with 1234 500 1000)
(check "parental while locked: code 11" (= (rb 3) 11))
(proc-data (mk (list 0x4B 2 8 0 0)))
(check "parental short packet: code 4" (= (rb 3) 4))
;; limits never exceed boot ceiling
(reset)
(proc-data (mk-setpin 0 1234))
(par-with 1234 700 50000)
(proc-data (mk-custom2 3 1000 65535 65535 4294967295))
(send-req (list 0x4B 2 1 3))
(define stub-fet 85.0) (ticks 30) (define stub-fet 20.0) (ticks 60)
(check "parental+custom: all conf-set within ceiling" (= (violations) 0))
(check "parental+custom: final scale <= 0.7, erpm <= 50000" (and (<= (cget 'l-current-max-scale) 0.7001) (<= (cget 'l-max-erpm) 50000.01)))
;; reply layout bytes 19-21 + unchanged 0..18
(reset)
(proc-data (mk-setpin 0 1234))
(proc-data (mk-n 1))
(par-with 1234 250 0)
(define rep (ix stub-sent 0))
(check "reply 24 bytes, b19 = neutral|parental = 3" (and (= (buflen rep) 24) (= (bufget-u8 rep 19) 3)))
(check "reply b20-21 = 250 BE" (and (= (bufget-u8 rep 20) 0) (= (bufget-u8 rep 21) 250)))
(check "reply b17 pin-set, b18 0, b0/b1 intact" (and (= (bufget-u8 rep 17) 2) (= (bufget-u8 rep 18) 0) (= (bufget-u8 rep 0) 0x4B) (= (bufget-u8 rep 1) 2)))
(check "reply b4-6 mode/eff-scale unchanged layout" (and (= (bufget-u8 rep 4) 0) (= (bufget-u16 rep 5) (rnd (* eff-scale 1000.0)))))


;; =========================================================== traction control
(defun tc-req (p) (send-req (list 0x4B 2 9 p)))
(defun tcb (i) (bufget-u8 (ix stub-sent 0) i))
;; simulate a wheel-spin: erpm rises by `step` per 0.1 s tick, n ticks, current 20 A
(defun spin (n step)
  (looprange i 0 n { (define stub-rpm (+ stub-rpm step)) (define stub-cur 20.0) (derate-tick) }))

(reset)
(check "tc: off by default" (and (= tc-pct 0) (approx tc-scale 1.0)))
(tc-req 50)
(check "tc: cmd 9 accepted, reply 24 bytes, b3=0, b2=9" (and (= (rb 3) 0) (= (rb 2) 9) (= (buflen (ix stub-sent 0)) 24)))
(check "tc: reply b22 = percent" (= (tcb 22) 50))
(tc-req 101)
(check "tc: >100 rejected with code 2, unchanged" (and (= (rb 3) 2) (= tc-pct 50) (= (rb 8) 2)))
(proc-data (mk (list 0x4B 2 9)))
(check "tc: short packet rejected code 4" (and (= (rb 3) 4) (= tc-pct 50)))
(define stub-rpm 3000.0) (ticks 1)
(tc-req 80)
(check "tc: raise while moving ok" (and (= (rb 3) 0) (= tc-pct 80)))
(tc-req 20)
(check "tc: lower while moving rejected code 3" (and (= (rb 3) 3) (= tc-pct 80) (= (rb 8) 3)))
(define stub-rpm 0.0) (ticks 1)
(tc-req 20)
(check "tc: lower at standstill ok" (and (= (rb 3) 0) (= tc-pct 20)))
(tc-req 0)
(check "tc: 0 turns off" (and (= (rb 3) 0) (= tc-pct 0) (= (tcb 22) 0)))
;; locked
(reset)
(proc-data (mk-setpin 0 1234))
(tc-req 60)
(lock-with 1234)
(tc-req 90)
(check "tc: accepted while locked (raise)" (and (= (rb 3) 0) (= tc-pct 90)))
(tc-req 10)
(check "tc: lower accepted while locked at standstill" (and (= (rb 3) 0) (= tc-pct 10)))
(ticks 3)
(check "tc: locked still forces scale 0" (and (approx (cget 'l-current-max-scale) 0.0) stub-out-disabled))
;; pct 0: spin has no effect
(reset)
(spin 15 3000.0)
(check "tc: pct 0 => no effect (scale 1, flags 0)" (and (approx tc-scale 1.0) (= (tc-flags3) 0)))
;; slip at 100%: floor 0.3, step 0.15/tick, thr = 20000*(2-1)=20000/s => 2000 per tick
(reset)
(tc-req 100)
(spin 1 1000.0)
(check "tc: below threshold no intervention" (approx tc-scale 1.0))
(spin 1 1000.0)
(spin 1 5000.0)
(check "tc: slip reduces by 0.15 at 100%" (approx tc-scale 0.85))
(check "tc: status bit0 set while intervening" (progn (send-req (list 0x4B 2 3)) (= (bitwise-and (tcb 23) 1) 1)))
(spin 12 5000.0)
(check "tc: floor reached = 1 - 0.7 at 100%" (approx tc-scale 0.3))
(check "tc: conf scale applied = min(eff, tc) = 0.3" (approx (cget 'l-current-max-scale) 0.3))
;; floor at 50%: 0.65, thr = 20000*1.5 = 30000/s => 3000/tick
(reset)
(tc-req 50)
(spin 1 2500.0) (spin 1 2500.0)
(check "tc: 50% threshold higher: 2500/tick no slip" (approx tc-scale 1.0))
(spin 20 6000.0)
(check "tc: 50% floor = 0.65" (approx tc-scale 0.65))
;; never above non-TC scale: eco 0.4 target, tc recovers to 1 -> applied stays <= 0.4
(define stub-cur 0.0) (define stub-rpm 20000.0) (ticks 30)
(check "tc: recovered to 1" (approx tc-scale 1.0))
(check "tc: recovered, flag bit0 clear" (= (bitwise-and (tc-flags3) 1) 0))
(check "tc: never raises above mode scale (eco 0.4)" (<= (cget 'l-current-max-scale) 0.4001))
(reset)
(tc-req 100)
(define stub-fet 85.0) (ticks 30)
(define base (cget 'l-current-max-scale))
(spin 8 5000.0)
(check "tc: derate lower than tc floor stays (min)" (<= (cget 'l-current-max-scale) (+ base 0.0001)))
(check "tc: all conf-set within ceiling" (= (violations) 0))
;; recovery rate +0.5/s => 0.05 per tick
(reset)
(tc-req 100)
(send-req (list 0x4B 2 1 2)) (ticks 60)
(spin 14 5000.0)
(define stub-cur 0.0)
(define t0 tc-scale)
(ticks 2)
(check "tc: recovery +0.05 per tick" (approx tc-scale (+ t0 0.1)))
;; reverse / no current: no slip
(reset)
(tc-req 100)
(define stub-rpm 0.0) (define stub-cur 20.0)
(looprange i 0 5 { (define stub-rpm (- stub-rpm 5000.0)) (derate-tick) })
(check "tc: reverse rise (negative erpm) ignored" (approx tc-scale 1.0))
(reset)
(tc-req 100)
(looprange i 0 5 { (define stub-rpm (+ stub-rpm 5000.0)) (define stub-cur 0.0) (derate-tick) })
(check "tc: no motor current => no slip" (approx tc-scale 1.0))
;; airborne
(reset)
(tc-req 100)
(define stub-imu (list 0.0 0.0 0.1))
(spin 1 5000.0)
(check "tc: free-fall 1 tick (0.1 s) not yet airborne" (= tc-air 0))
(spin 1 5000.0)
(check "tc: >100 ms free fall = airborne, status bit1" (progn (send-req (list 0x4B 2 3)) (= (bitwise-and (tcb 23) 2) 2)))
(spin 10 5000.0)
(check "tc: airborne => no intervention" (approx tc-scale 1.0))
(define stub-imu (list 0.0 0.0 1.0))
(spin 1 5000.0)
(check "tc: normal gravity clears airborne" (= tc-air 0))
(spin 3 5000.0)
(check "tc: intervenes again when grounded" (< tc-scale 0.99))
;; missing IMU
(reset)
(tc-req 100)
(define stub-imu nil)
(spin 5 5000.0)
(check "tc: missing IMU does not crash, airborne 0, TC works" (and (= tc-air 0) (< tc-scale 0.9) (= (bitwise-and (tcb 23) 2) 0) (= (bitwise-and (progn (send-req (list 0x4B 2 3)) (tcb 23)) 2) 0)))
(define stub-imu (list 1 2))
(spin 1 5000.0)
(check "tc: malformed IMU result ignored" (= tc-air 0))
(reset)

(print "RESULT: " t-run " tests, " (- t-run t-fail) " passed, " t-fail " failed")
(if (= t-fail 0) (print "ALL-TESTS-PASSED") (print "TESTS-FAILED"))
