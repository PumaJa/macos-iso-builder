;; ========================================================= 8. status layout
(reset)
(define cur-mode 2) (define eff-scale 0.575) (define flags 5) (define last-reject 3)
(define t-fet 55.4) (define t-mot -5.0) (define vin 48.3) (define erpm -1234.0)
(send-req (list 0x4B 1 3))
(define rep (ix stub-sent 0))
(check "status: 24 bytes (17 + lock 2 + flags2/parental 3 + tc 2)" (= (buflen rep) 24))
(check "status: b0 magic 0x4B" (= (bufget-u8 rep 0) 0x4B))
(check "status: b1 version 1" (= (bufget-u8 rep 1) 1))
(check "status: b2 echoed cmd 3" (= (bufget-u8 rep 2) 3))
(check "status: b3 result 0" (= (bufget-u8 rep 3) 0))
(check "status: b4 mode 2" (= (bufget-u8 rep 4) 2))
(check "status: b5-6 scale permille 575 (u16 BE)" (and (= (bufget-u8 rep 5) 2) (= (bufget-u8 rep 6) 63) (= (bufget-u16 rep 5) 575)))
(check "status: b7 flags 5" (= (bufget-u8 rep 7) 5))
(check "status: b8 last reject 3" (= (bufget-u8 rep 8) 3))
(check "status: b9 FET temp i8 (55)" (= (bufget-i8 rep 9) 55))
(check "status: b10 motor temp i8 negative (-5)" (= (bufget-i8 rep 10) -5))
(check "status: b11-12 vin 0.1V (483)" (= (bufget-u16 rep 11) 483))
(check "status: b13-16 erpm i32 negative (-1234)" (= (bufget-i32 rep 13) -1234))
(check "status: erpm bytes big-endian" (and (= (bufget-u8 rep 13) 255) (= (bufget-u8 rep 14) 255) (= (bufget-u8 rep 15) 251) (= (bufget-u8 rep 16) 46)))
(define erpm 123456.0) (define vin 100.0) (define t-fet 127.0)
(send-status 3 0)
(check "status: erpm +123456 i32" (= (bufget-i32 (ix stub-sent 0) 13) 123456))
(check "status: vin 100.0V = 1000" (= (bufget-u16 (ix stub-sent 0) 11) 1000))
(check "status: fet 127 i8" (= (bufget-i8 (ix stub-sent 0) 9) 127))
;; scale permille exactness for the default fractions
(define eff-scale 0.7) (send-status 3 0)
(check "status: 0.7 -> 700 permille (float rounding)" (= (bufget-u16 (ix stub-sent 0) 5) 700))
(define eff-scale 0.15) (send-status 3 0)
(check "status: 0.15 -> 150 permille" (= (bufget-u16 (ix stub-sent 0) 5) 150))
(define eff-scale 1.0) (send-status 3 0)
(check "status: 1.0 -> 1000 permille" (= (bufget-u16 (ix stub-sent 0) 5) 1000))
;; every permille value 0..1000 must survive float->int (to-i alone truncates)
(define pm-bad 0)
(looprange i 0 1001
  {
    (define eff-scale (/ (to-float i) 1000.0))
    (define stub-sent nil)
    (send-status 3 0)
    (if (!= (bufget-u16 (ix stub-sent 0) 5) i) (define pm-bad (+ pm-bad 1)) nil)
  })
(check "status: all 1001 permille values round-trip exactly" (= pm-bad 0))
(define pm-bad 0)
(looprange i 0 400
  {
    (define vin (/ (to-float i) 10.0))
    (define stub-sent nil)
    (send-status 3 0)
    (if (!= (bufget-u16 (ix stub-sent 0) 11) i) (define pm-bad (+ pm-bad 1)) nil)
  })
(check "status: all vin 0.1V values 0..40.0 round-trip" (= pm-bad 0))
(define t-fet 55.6) (define t-mot -4.6) (define erpm -1234.6) (send-status 3 0)
(check "status: temps/erpm rounded to nearest (56,-5,-1235)" (and (= (bufget-i8 (ix stub-sent 0) 9) 56) (= (bufget-i8 (ix stub-sent 0) 10) -5) (= (bufget-i32 (ix stub-sent 0) 13) -1235)))
(define stub-sent nil)
;; unknown command
(reset)
(send-req (list 0x4B 1 10))
(check "unknown cmd 10: code 5, echoes cmd" (and (= (rb 3) 5) (= (rb 2) 10) (= (rb 8) 5)))
(send-req (list 0x4B 1 1))
(check "cmd 1 without index (len 3): code 4" (and (= (rb 3) 4) (= (rb 2) 1)))

;; =============================================== 9. bad magic/version ignored
(reset)
(define n0 (nsent))
(send-req (list 0x4C 1 1 2))
(send-req (list 0x4B 3 1 2))
(send-req (list 0x4B 0 1 2))
(send-req (list 0x00 0x00 0x00 0x00))
(send-req (list 0x4B 1))
(send-req (list 0x4B))
(proc-data (bufcreate 0))
(check "bad magic/version/short: no reply sent" (= (nsent) n0))
(check "bad magic/version: mode unchanged" (= cur-mode 0))
(check "bad magic/version: last-reject unchanged" (= last-reject 0))
(check "bad magic/version: no conf writes" (= (length stub-conf-log) 0))

;; ============================================ 10. event handler (recv path)
(reset)
(define hpid (spawn event-handler))
(send hpid (cons 'event-data-rx (mk (list 0x4B 1 1 1))))
(sleep 0.3)
(check "event-handler: recv pattern dispatches set-mode" (and (= cur-mode 1) (= (nsent) 1) (= (rb 3) 0)))
(send hpid 'some-other-message)
(send hpid (cons 'event-data-rx (mk (list 0x00 1 1 2))))
(send hpid (cons 'event-data-rx (mk (list 0x4B 1 3))))
(sleep 0.3)
(check "event-handler: survives unrelated msgs + bad packet, still serves" (and (= (nsent) 2) (= (rb 2) 3) (= cur-mode 1)))
(kill hpid 0)

