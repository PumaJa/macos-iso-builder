(check "parental: race erpm clamped to 30000 and applied" (and (approx (mode-erpm 2) 30000.0) (approx (cget 'l-max-erpm) 30000.0)))
(check "parental: sport erpm 0.75*ceil clamped to 30000" (approx (mode-erpm 1) 30000.0))
(check "parental: eco erpm (50000) clamped to 30000" (approx (mode-erpm 0) 30000.0))
(ticks 60)
(check "parental: applied current scale <= 0.5 after ticks" (<= (cget 'l-current-max-scale) 0.5001))
(check "parental: watt not limited (separate dims)" (approx (cget 'l-watt-max) ceil-watt))
(proc-data (mk-custom2 3 1000 1000 250 90000))
(check "parental: custom scale clamped to 0.5, erpm to 30000" (and (approx (ix m-scale 3) 0.5) (approx (ix m-erpm 3) 30000.0)))
(proc-data (mk-custom 4 900 1000 250 90000))
(check "parental: v1 custom clamped too" (and (approx (ix m-scale 4) 0.5) (approx (ix m-erpm 4) 30000.0)))
