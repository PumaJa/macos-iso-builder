(defun race-hot ()   ; race mode, eff-scale pre-settled at 1.0
  {
    (reset)
    (define cur-mode 2)
    (define eff-scale 1.0)
  })

(race-hot) (define stub-fet 80.0) (ticks 8)
(check "tick: FET 80C -> eff 0.575" (approx eff-scale 0.575))
(check "tick: FET flag bit0 only" (= flags 1))
(check "tick: conf scale = ceil * eff" (approx (cget 'l-current-max-scale) (* ceil-scale 0.575)))
(race-hot) (define stub-mot 105.0) (ticks 8)
(check "tick: motor 105C -> eff 0.575, flag bit1" (and (approx eff-scale 0.575) (= flags 2)))
(race-hot) (define use-mot-temp 0) (define stub-mot 130.0) (ticks 12)
(check "tick: use-mot-temp 0 ignores motor temp" (and (approx eff-scale 1.0) (= flags 0)))
(race-hot) (define stub-vin 43.5) (ticks 8)
(check "tick: vin 43.5V -> eff 0.575, flag bit2" (and (approx eff-scale 0.575) (= flags 4)))
(race-hot) (define stub-fet 75.0) (define stub-mot 100.0) (define stub-vin 44.0) (ticks 15)
(check "tick: min of all derates (mot 100C=0.7167 lowest? fet 75=0.7875, vin 44=0.7167)" (approx eff-scale (derate-lo 44.0 45.0 42.0)))
(check "tick: all flags 7" (= flags 7))
(race-hot) (define stub-fet 95.0) (ticks 20)
(check "tick: FET 95C -> floor 0.15" (approx eff-scale 0.15))
(race-hot) (define stub-fet 70.0) (ticks 5)
(check "tick: FET exactly at start -> no derate" (and (approx eff-scale 1.0) (= flags 0)))
;; mode scale is also an upper bound
(reset) (define cur-mode 1) (ticks 40)
(check "tick: sport settles at its mode scale 0.7" (approx eff-scale 0.7))
(check "tick: sport conf scale = 0.7*ceil" (approx (cget 'l-current-max-scale) 0.7))
(check "tick: sensors mirrored to globals" (and (approx t-fet 25.0) (approx vin 50.0)))

;; ============================================================ 7. rate limiter
(race-hot) (define stub-fet 100.0)
(derate-tick)
(check "rate: down step 1 (1.0 -> 0.9)" (approx eff-scale 0.9))
(derate-tick)
(check "rate: down step 2 (0.8)" (approx eff-scale 0.8))
(ticks 3)
