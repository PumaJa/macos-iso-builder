(defun mk-pin (cmd pin)
  (let ((b (bufcreate 7)))
    { (bufset-u8 b 0 0x4B) (bufset-u8 b 1 2) (bufset-u8 b 2 cmd) (bufset-u32 b 3 pin) b }))
(defun mk-setpin (old new)
  (let ((b (bufcreate 11)))
    { (bufset-u8 b 0 0x4B) (bufset-u8 b 1 2) (bufset-u8 b 2 6) (bufset-u32 b 3 old) (bufset-u32 b 7 new) b }))
(defun lock-with (pin) (proc-data (mk-pin 4 pin)))
(defun unlock-with (pin) (proc-data (mk-pin 5 pin)))
(defun count-of (x l) (let ((n 0)) { (looprange i 0 (length l) (if (= (ix l i) x) (setq n (+ n 1)) nil)) n }))
(defun simulate-reboot ()   ; RAM state lost, EEPROM kept, stored config restored
  {
    (define stub-conf (setassoc stub-conf 'l-current-max-scale ceil-scale))
    (define stub-out-disabled nil)
    (define cur-mode 0) (define last-reject 0) (define tamper 0) (define tamper-t 0.0)
    (define fail-cnt 0) (define fail-series 0) (define lock-until 0.0) (define uptime 0.0)
    (define applied-scale -1.0) (define neutral 0)
    (lock-boot)
    (define eff-scale (if (= locked 1) 0.0 (mode-scale 0)))
  })

