# Copy to .env and edit. JWT_SECRET is REQUIRED (generate: openssl rand -hex 32)
JWT_SECRET=
# Database password (used by db, api and backup services)
POSTGRES_PASSWORD=change-me-too
# Host port the API/dashboard is published on
API_PORT=8080
# Only needed with the https profile (docker compose --profile https up -d)
DOMAIN=kinetic.example.com
ACME_EMAIL=you@example.com
# Set to 1 when running behind a reverse proxy (Caddy/NPM/Traefik) so client IPs are honoured
TRUST_PROXY=0
# Backups: hours between dumps and number of dumps to keep
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
